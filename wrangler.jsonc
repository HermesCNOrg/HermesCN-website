{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "hermescn-community",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/baidu_verify_codeva-bOmrgYlnmW.html",
      "/sitemap.xml",
      "/sitemap-main.xml",
    ],
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hermescn-community",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "routes": [
    {
      "pattern": "hermescn.org",
      "custom_domain": true,
    },
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
}

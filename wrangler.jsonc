{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker-entry.ts",
  "name": "hermescn-community",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hermescn-community"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "SKILLS_CATALOG_KV",
      "id": "f2a4575739a54bef889ef15ed4b8c6bf"
    }
  ],
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "routes": [
    {
      "pattern": "hermescn.org",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true
  }
}
